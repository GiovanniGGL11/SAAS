generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                  String             @id @default(cuid())
  clerkOrgId          String             @unique
  name                String
  slug                String             @unique
  timezone            String             @default("America/Sao_Paulo")
  // Where clients without a link ask for one ("Pedir acesso"); digits only, with country code.
  whatsapp            String?
  // Lembrete automático por e-mail na véspera do atendimento (precisa de RESEND_API_KEY e CRON_SECRET).
  remindersByEmail    Boolean            @default(false)
  // Empresa de demonstração (dados fictícios): fica fora do link público e pode ser excluída.
  isDemo              Boolean            @default(false)
  // Link público: de quantos em quantos minutos oferecer horários (15, 30, 60). 0 = pela duração do serviço.
  bookingSlotStep     Int                @default(15)
  // Identidade na página pública de agendamento (/agendar/[slug]). A logo vem da organização no Clerk.
  zipCode             String?
  street              String?
  number              String?
  complement          String?
  district            String?
  city                String?
  state               String?
  instagram           String?
  cancellationPolicy  String?
  // Aviso de privacidade escrito pela empresa, mostrado no link de preenchimento das fichas.
  formsPrivacyNotice  String?
  // Link "avalie no Google" mostrado a quem dá nota alta depois do atendimento.
  googleReviewUrl     String?
  // WhatsApp automático (Z-API): credenciais da instância, guardadas cifradas.
  zapiInstanceId      String?
  zapiToken           String?
  zapiClientToken     String?
  waAutoConfirm       Boolean            @default(false)
  waAutoReminder      Boolean            @default(false)
  waAutoReview        Boolean            @default(false)
  waAutoBirthday      Boolean            @default(false)
  // Assinatura do Atendafy (cobrança pela Asaas da plataforma).
  subscriptionStatus  SubscriptionStatus @default(TRIAL)
  trialEndsAt         DateTime?
  plan                String?
  currentPeriodEnd    DateTime?
  asaasCustomerId     String?
  asaasSubscriptionId String?            @unique
  // Sinal por PIX no agendamento online: conta Asaas do próprio salão (chave cifrada).
  asaasApiKey         String?
  depositPercent      Int                @default(0)
  depositHoldMinutes  Int                @default(30)
  // Autonomia da IA. Padrão: pedir aprovação. "Executar regras autorizadas" só vale no Pro.
  aiAutonomyMode      AiAutonomyMode     @default(APPROVAL)
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  professionals             Professional[]
  services                  Service[]
  clients                   Client[]
  appointments              Appointment[]
  auditLogs                 AuditLog[]
  products                  Product[]
  stockMovements            StockMovement[]
  transactions              Transaction[]
  coupons                   Coupon[]
  loyaltyProgram            LoyaltyProgram?
  loyaltyEntries            LoyaltyEntry[]
  googleCalendarConnections GoogleCalendarConnection[]
  waitlistEntries           WaitlistEntry[]
  paymentMethodFees         PaymentMethodFee[]
  cashSessions              CashSession[]
  recurringExpenses         RecurringExpense[]
  financeCategories         FinanceCategory[]
  professionalAdvances      ProfessionalAdvance[]
  commissionPayouts         CommissionPayout[]
  packagePlans              PackagePlan[]
  clientPackages            ClientPackage[]
  giftCards                 GiftCard[]
  reviews                   Review[]
  campaigns                 Campaign[]
  formTemplates             FormTemplate[]
  formEntries               FormEntry[]
  formPermissions           FormPermission[]
  packageMovements          PackageMovement[]
  sessionRecords            SessionRecord[]
  stockPurchases            StockPurchase[]
  whatsappMessages          WhatsappMessage[]
  aiUsagePeriods            AiUsagePeriod[]
  aiUsageReservations       AiUsageReservation[]
  aiUsageEvents             AiUsageEvent[]
  aiActionProposals         AiActionProposal[]
  aiTaskAuthorizations      AiTaskAuthorization[]
  addOns                    CompanyAddOn[]
  quotes                    Quote[]
  tasks                     Task[]
  waitlistOffers            WaitlistOffer[]
  preferences               BusinessPreferences?
  importBatches             ImportBatch[]
  automationRuns            AutomationRun[]
  dailySummaries            DailySummary[]
}

model WebhookEvent {
  id           String   @id @default(cuid())
  clerkEventId String   @unique
  type         String
  processedAt  DateTime @default(now())
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

model Professional {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id])
  name            String
  email           String?
  phone           String?
  color           String
  avatarUrl       String?
  active          Boolean         @default(true)
  commissionType  CommissionType?
  commissionValue Decimal?        @db.Decimal(10, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Meta de faturamento do mês (serviços cobrados), acompanhada no painel.
  monthlyGoal Float?

  availabilities         ProfessionalAvailability[]
  advances               ProfessionalAdvance[]
  commissionPayouts      CommissionPayout[]
  blocks                 ScheduleBlock[]
  appointments           Appointment[]
  waitlistEntries        WaitlistEntry[]
  reviews                Review[]
  responsibleForPackages ClientPackage[]
  sessionRecords         SessionRecord[]

  @@unique([companyId, email])
  @@index([companyId])
}

model ProfessionalAvailability {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Int
  startTime      String
  endTime        String

  @@index([professionalId, weekday])
}

model ScheduleBlock {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startAt        DateTime
  endAt          DateTime
  reason         String?
  /// Bloqueios repetidos toda semana (curso, almoço fixo) compartilham a série para remover juntos.
  seriesId       String?

  @@index([professionalId, startAt, endAt])
  @@index([seriesId])
}

model Service {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  name            String
  description     String?
  category        String?
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  color           String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Comissão própria deste serviço (%), no lugar da regra do profissional. Vazio = regra dele.
  commissionPercent Float?
  // Retorno sugerido: em quantos dias o cliente costuma refazer este serviço. Vazio = sem sugestão.
  returnAfterDays   Int?
  /// Checklist do atendimento (itens conferidos na Visão do atendimento). Vazio = sem checklist.
  checklistItems    String[]              @default([])
  appointmentItems  AppointmentItem[]
  packagePlans      PackagePlan[]
  clientPackages    ClientPackage[]
  appointments      Appointment[]
  loyaltyRewardOf   LoyaltyProgram[]
  waitlistEntries   WaitlistEntry[]
  formTemplates     FormTemplateService[]
  supplies          ServiceSupply[]

  @@index([companyId])
}

model Client {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  name          String
  phone         String?
  email         String?
  cpf           String?
  birthDate     DateTime?
  notes         String?
  // Endereço opcional; o CEP é guardado só com dígitos e o resto vem do ViaCEP ou do usuário.
  zipCode       String?
  street        String?
  number        String?
  complement    String?
  district      String?
  city          String?
  state         String?
  isVip         Boolean   @default(false)
  active        Boolean   @default(true)
  // Signed into the personal client-area link; bumping it revokes every link sent before.
  portalVersion Int       @default(1)
  // Quem indicou este cliente (programa de indicação).
  referredById  String?
  referredBy    Client?   @relation("Referrals", fields: [referredById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointments    Appointment[]
  loyaltyEntries  LoyaltyEntry[]
  waitlistEntries WaitlistEntry[]
  transactions    Transaction[]
  packages        ClientPackage[]
  giftCards       GiftCard[]
  referrals       Client[]            @relation("Referrals")
  reviews         Review[]
  campaignSends   CampaignRecipient[]
  formEntries     FormEntry[]
  sessionRecords  SessionRecord[]
  quotes          Quote[]
  tasks           Task[]

  @@unique([companyId, phone])
  @@index([companyId])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELED
  NO_SHOW
}

model Appointment {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])

  startAt DateTime
  endAt   DateTime
  status  AppointmentStatus @default(SCHEDULED)

  // Snapshot at creation time so edits to Service later don't rewrite history.
  serviceNameSnapshot     String
  durationMinutesSnapshot Int
  priceSnapshot           Decimal @db.Decimal(10, 2)

  notes String?

  createdByUserId    String
  updatedByUserId    String?
  // Quando o lembrete da véspera foi enviado (e-mail automático ou WhatsApp pela equipe).
  reminderSentAt     DateTime?
  // Sinal por PIX do agendamento online (o horário fica reservado até depositExpiresAt).
  depositAmount      Decimal?       @db.Decimal(10, 2)
  depositStatus      DepositStatus?
  depositPaymentId   String?        @unique
  depositExpiresAt   DateTime?
  canceledAt         DateTime?
  canceledByUserId   String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productSales     AppointmentProduct[]
  /// Serviços do atendimento quando há mais de um (corte + barba). Com um só, fica vazio e vale
  /// o serviceId/snapshots do próprio agendamento; com vários, eles guardam a soma.
  items            AppointmentItem[]
  credits          AppointmentCredit[]
  review           Review?
  transactions     Transaction[]
  loyaltyEntries   LoyaltyEntry[]
  googleEvents     GoogleCalendarEvent[]
  /// Sessão de pacote planejada para este atendimento (escolhida ao agendar); o consumo só
  /// acontece ao concluir.
  clientPackageId  String?
  clientPackage    ClientPackage?        @relation("PlannedPackageSessions", fields: [clientPackageId], references: [id])
  formEntries      FormEntry[]
  sessionRecord    SessionRecord?
  packageMovements PackageMovement[]
  /// Itens do checklist do serviço já conferidos neste atendimento (pelo texto do item).
  checklistChecked String[]              @default([])
  waitlistOffer    WaitlistOffer?

  @@index([companyId, startAt])
  @@index([companyId, professionalId, startAt])
  @@index([companyId, status, startAt])
  @@index([companyId, clientId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  entityType String
  entityId   String
  action     String
  userId     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([companyId, entityType, entityId])
  // Avisos do sino: o que clientes fizeram nas últimas horas.
  @@index([companyId, createdAt])
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  sku         String?
  description String?
  costPrice   Decimal  @db.Decimal(10, 2)
  salePrice   Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(0)
  minQuantity Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements        StockMovement[]
  appointmentSales AppointmentProduct[]
  purchaseItems    StockPurchaseItem[]
  serviceSupplies  ServiceSupply[]

  @@unique([companyId, sku])
  @@index([companyId])
}

enum StockMovementType {
  IN
  OUT
  SALE
}

model StockMovement {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  type            StockMovementType
  quantity        Int
  reason          String?
  /// Atendimento que consumiu (ou devolveu) este material: base do estorno.
  appointmentId   String?
  createdByUserId String
  createdAt       DateTime          @default(now())

  @@index([companyId, productId])
  @@index([companyId, createdAt])
  @@index([appointmentId])
}

// Line item for a product sold during an appointment (e.g. a shampoo sold
// alongside a haircut). Debits stock via a StockMovement(type=SALE) and
// generates its own Transaction — kept separate from the appointment's
// service-completion Transaction since a checkout can have several items.
model AppointmentItem {
  id              String      @id @default(cuid())
  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service     @relation(fields: [serviceId], references: [id])
  position        Int
  nameSnapshot    String
  durationMinutes Int
  priceSnapshot   Decimal     @db.Decimal(10, 2)

  @@index([appointmentId])
  @@index([serviceId])
}

model AppointmentProduct {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int
  priceSnapshot Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELED
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  OTHER
}

model Transaction {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  type            TransactionType
  status          TransactionStatus @default(PAID)
  description     String
  category        String?
  amount          Decimal           @db.Decimal(10, 2)
  paymentMethod   PaymentMethod?
  dueDate         DateTime?
  paidAt          DateTime?
  appointmentId   String?
  appointment     Appointment?      @relation(fields: [appointmentId], references: [id])
  notes           String?
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Taxa da maquininha descontada desta entrada e o dia em que o dinheiro cai na conta. Gravados
  // no pagamento (mudar a taxa depois não reescreve o passado).
  feeAmount          Decimal           @default(0) @db.Decimal(10, 2)
  settlesAt          DateTime?
  // Conta fixa que gerou este lançamento, e o mês dela ("2026-10") — um lançamento por mês.
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  recurringMonth     String?
  // Cliente da venda/cobrança (fiado, pacote, vale-presente, atendimento): para cobrar o fiado.
  clientId           String?
  client             Client?           @relation(fields: [clientId], references: [id])
  /// Pacote que este lançamento paga: o "total pago" do pacote sai daqui, não de um marcador manual.
  clientPackageId    String?
  clientPackage      ClientPackage?    @relation(fields: [clientPackageId], references: [id])

  @@unique([recurringExpenseId, recurringMonth])
  @@index([companyId, type, status])
  @@index([companyId, dueDate])
  @@index([companyId, paidAt])
  @@index([appointmentId])
  @@index([companyId, clientId, status])
}

/// Taxa e prazo de recebimento de cada forma de pagamento (maquininha, PIX).
model PaymentMethodFee {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  paymentMethod  PaymentMethod
  feePercent     Decimal       @default(0) @db.Decimal(5, 2)
  settlementDays Int           @default(0)
  updatedAt      DateTime      @updatedAt

  @@unique([companyId, paymentMethod])
}

/// Caixa do dia: aberto com um troco, fechado com o dinheiro contado. Só um aberto por empresa
/// (índice parcial na migration).
model CashSession {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  openedAt       DateTime       @default(now())
  openedByUserId String
  openingAmount  Decimal        @db.Decimal(10, 2)
  closedAt       DateTime?
  closedByUserId String?
  expectedCash   Decimal?       @db.Decimal(10, 2)
  countedCash    Decimal?       @db.Decimal(10, 2)
  notes          String?
  movements      CashMovement[]

  @@index([companyId, openedAt])
}

enum CashMovementKind {
  WITHDRAWAL
  DEPOSIT
}

/// Sangria (dinheiro tirado da gaveta) e suprimento (colocado). Não é receita nem despesa.
model CashMovement {
  id              String           @id @default(cuid())
  sessionId       String
  session         CashSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind            CashMovementKind
  amount          Decimal          @db.Decimal(10, 2)
  reason          String?
  createdByUserId String
  createdAt       DateTime         @default(now())

  @@index([sessionId])
}

/// Conta fixa (aluguel, luz, sistema): vira um lançamento pendente todo mês.
model RecurringExpense {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  description   String
  category      String?
  amount        Decimal        @db.Decimal(10, 2)
  dayOfMonth    Int
  paymentMethod PaymentMethod?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  transactions  Transaction[]

  @@index([companyId, active])
}

model FinanceCategory {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id])
  type      TransactionType
  name      String
  createdAt DateTime        @default(now())

  @@unique([companyId, type, name])
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id])
  code          String
  description   String?
  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(10, 2)
  active        Boolean            @default(true)
  expiresAt     DateTime?
  maxUses       Int?
  usedCount     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

enum LoyaltyMode {
  STAMPS
  POINTS
  CASHBACK
}

enum LoyaltyRewardType {
  FREE_SERVICE
  PERCENT_DISCOUNT
  FIXED_DISCOUNT
  CUSTOM
}

enum LoyaltyEntryKind {
  EARN
  REDEEM
}

// One per company. The owner picks the model (stamp card, points per R$,
// or cashback) and, for stamps/points, what the reward is.
model LoyaltyProgram {
  id                String            @id @default(cuid())
  companyId         String            @unique
  company           Company           @relation(fields: [companyId], references: [id])
  active            Boolean           @default(false)
  mode              LoyaltyMode       @default(STAMPS)
  stampsRequired    Int               @default(10)
  pointsPerReal     Decimal           @default(1) @db.Decimal(10, 2)
  pointsRequired    Int               @default(100)
  cashbackPercent   Decimal           @default(5) @db.Decimal(5, 2)
  rewardType        LoyaltyRewardType @default(FREE_SERVICE)
  rewardServiceId   String?
  rewardService     Service?          @relation(fields: [rewardServiceId], references: [id])
  rewardValue       Decimal?          @db.Decimal(10, 2)
  rewardDescription String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// Ledger of stamps/points/cashback. A client's balance is EARN minus REDEEM
// for the program's current mode, so switching modes starts balances fresh
// without rewriting history. `amount` is stamps, points or R$ by mode.
model LoyaltyEntry {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id])
  appointmentId   String?
  appointment     Appointment?     @relation(fields: [appointmentId], references: [id])
  mode            LoyaltyMode
  kind            LoyaltyEntryKind
  amount          Decimal          @db.Decimal(10, 2)
  description     String?
  createdByUserId String
  createdAt       DateTime         @default(now())

  // At most one EARN per appointment, so re-marking it DONE never double-credits.
  @@unique([appointmentId, kind])
  @@index([companyId, clientId, mode])
}

// One per (company, user): the Google account a team member linked so the
// appointments of the professionals they picked show up in their own Google
// Calendar. The refresh token is stored AES-GCM encrypted, never in clear.
model GoogleCalendarConnection {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  userId          String
  googleEmail     String
  refreshTokenEnc String
  professionalIds String[]
  // Google revoked/expired the grant; sync pauses until the user reconnects.
  needsReconnect  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events GoogleCalendarEvent[]

  @@unique([companyId, userId])
}

// Which Google event mirrors which appointment, per connection — needed to
// update or delete the right event when the appointment changes.
model GoogleCalendarEvent {
  id            String                   @id @default(cuid())
  connectionId  String
  connection    GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  appointmentId String
  appointment   Appointment              @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  googleEventId String
  syncedAt      DateTime                 @default(now())

  @@unique([connectionId, appointmentId])
  @@index([appointmentId])
}

enum WaitlistStatus {
  WAITING
  FULFILLED
  CANCELED
  /// O interesse venceu (validUntil) sem vaga.
  EXPIRED
}

/// Canal que o cliente autorizou para ser chamado.
enum ContactChannel {
  WHATSAPP
  PHONE
  EMAIL
  NONE
}

/// Cliente esperando uma vaga num dia que estava cheio. A equipe avisa quando alguém cancela.
model WaitlistEntry {
  id                      String          @id @default(cuid())
  companyId               String
  company                 Company         @relation(fields: [companyId], references: [id])
  clientId                String
  client                  Client          @relation(fields: [clientId], references: [id])
  serviceId               String
  service                 Service         @relation(fields: [serviceId], references: [id])
  /// Opcional: quando o cliente só quer um profissional específico.
  professionalId          String?
  professional            Professional?   @relation(fields: [professionalId], references: [id])
  /// Dia desejado (AAAA-MM-DD) no fuso da empresa. Vazio = qualquer dia dentro das preferências.
  desiredDate             String?         @db.VarChar(10)
  /// Profissionais aceitos (vazio = o de professionalId, ou qualquer um).
  acceptedProfessionalIds String[]        @default([])
  /// Dias da semana aceitos (0 = domingo). Vazio = qualquer dia.
  weekdays                Int[]           @default([])
  /// Faixa de horário aceita, em minutos desde a meia-noite (vazio = o dia todo).
  timeFrom                Int?
  timeTo                  Int?
  /// Até quando o interesse vale.
  validUntil              DateTime?
  contactChannel          ContactChannel  @default(WHATSAPP)
  notes                   String?
  status                  WaitlistStatus  @default(WAITING)
  createdByUserId         String
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  offers                  WaitlistOffer[]

  @@index([companyId, status, desiredDate])
}

enum WaitlistOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELED
}

/// Convite de uma vaga para alguém da lista de espera: segura o horário até expiresAt. Só um
/// convite pendente por horário; aceitar revalida a agenda e cria o agendamento uma vez.
model WaitlistOffer {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  entryId         String
  entry           WaitlistEntry       @relation(fields: [entryId], references: [id])
  professionalId  String
  serviceId       String
  startAt         DateTime
  endAt           DateTime
  status          WaitlistOfferStatus @default(PENDING)
  /// Prazo de resposta (o horário fica segurado até aqui).
  expiresAt       DateTime
  appointmentId   String?             @unique
  appointment     Appointment?        @relation(fields: [appointmentId], references: [id])
  /// manual | automation
  origin          String              @default("manual")
  createdByUserId String
  respondedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([companyId, status, expiresAt])
  @@index([companyId, professionalId, startAt])
  @@index([entryId])
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELED
}

/// Orçamento. O conteúdo fica nas versões: mudar algo depois de enviado cria versão nova, e a
/// aprovação vale só para a versão (e o hash) aprovada. Aprovar não é pagar.
model Quote {
  id                        String         @id @default(cuid())
  companyId                 String
  company                   Company        @relation(fields: [companyId], references: [id])
  clientId                  String
  client                    Client         @relation(fields: [clientId], references: [id])
  /// Número sequencial por empresa (mostrado como #12).
  number                    Int
  title                     String
  status                    QuoteStatus    @default(DRAFT)
  currentVersion            Int            @default(1)
  responsibleProfessionalId String?
  approvedVersion           Int?
  approvedHash              String?
  approvedAt                DateTime?
  /// staff | client_link | client_portal
  approvedVia               String?
  approvedByUserId          String?
  approvalNote              String?
  rejectedAt                DateTime?
  rejectionReason           String?
  sentAt                    DateTime?
  /// Link protegido: a versão entra na assinatura; subir revoga os links enviados.
  shareVersion              Int            @default(0)
  shareExpiresAt            DateTime?
  /// Conversão (uma vez só): pacote ou venda criada a partir da versão aprovada.
  convertedAt               DateTime?
  convertedKind             String?
  convertedRefId            String?
  convertedByUserId         String?
  /// manual | ai
  origin                    String         @default("manual")
  createdByUserId           String
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  versions                  QuoteVersion[]
  tasks                     Task[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, clientId])
}

model QuoteVersion {
  id              String    @id @default(cuid())
  companyId       String
  quoteId         String
  quote           Quote     @relation(fields: [quoteId], references: [id])
  version         Int
  /// Itens: [{ kind, refId, description, quantity, sessions, unitPrice, discount }]
  items           Json
  subtotal        Decimal   @db.Decimal(10, 2)
  discount        Decimal   @db.Decimal(10, 2)
  total           Decimal   @db.Decimal(10, 2)
  paymentTerms    String?
  notes           String?
  validUntil      DateTime?
  contentHash     String
  createdByUserId String
  createdAt       DateTime  @default(now())

  @@unique([quoteId, version])
  @@index([companyId])
}

enum TaskStatus {
  OPEN
  DONE
  CANCELED
}

/// Tarefa de acompanhamento (retornar um orçamento, renovar um pacote...). Rotinas automáticas
/// usam dedupeKey para nunca criar a mesma tarefa duas vezes.
model Task {
  id                String     @id @default(cuid())
  companyId         String
  company           Company    @relation(fields: [companyId], references: [id])
  title             String
  details           String?
  dueAt             DateTime?
  status            TaskStatus @default(OPEN)
  clientId          String?
  client            Client?    @relation(fields: [clientId], references: [id])
  quoteId           String?
  quote             Quote?     @relation(fields: [quoteId], references: [id])
  clientPackageId   String?
  appointmentId     String?
  /// manual | ai | automation:<rotina>
  origin            String     @default("manual")
  dedupeKey         String?
  assignedUserId    String?
  createdByUserId   String
  completedAt       DateTime?
  completedByUserId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([companyId, dedupeKey])
  @@index([companyId, status, dueAt])
  @@index([companyId, clientId])
}

/// Vale/adiantamento pago ao profissional; é descontado no próximo fechamento de comissão.
model ProfessionalAdvance {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  professionalId  String
  professional    Professional      @relation(fields: [professionalId], references: [id])
  amount          Decimal           @db.Decimal(10, 2)
  description     String?
  transactionId   String?
  payoutId        String?
  payout          CommissionPayout? @relation(fields: [payoutId], references: [id])
  createdByUserId String
  createdAt       DateTime          @default(now())

  @@index([companyId, professionalId, payoutId])
}

/// Fechamento de comissão de um profissional num período: bruto − vales = pago.
model CommissionPayout {
  id              String                @id @default(cuid())
  companyId       String
  company         Company               @relation(fields: [companyId], references: [id])
  professionalId  String
  professional    Professional          @relation(fields: [professionalId], references: [id])
  periodStart     DateTime
  periodEnd       DateTime
  appointments    Int
  baseAmount      Decimal               @db.Decimal(10, 2)
  grossCommission Decimal               @db.Decimal(10, 2)
  advancesTotal   Decimal               @db.Decimal(10, 2)
  netAmount       Decimal               @db.Decimal(10, 2)
  transactionId   String?
  advances        ProfessionalAdvance[]
  createdByUserId String
  createdAt       DateTime              @default(now())

  @@index([companyId, professionalId, periodStart])
}

/// Pacote ("10 cortes por R$ 400") ou assinatura ("4 cortes por mês por R$ 150, renova todo mês").
model PackagePlan {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  name         String
  serviceId    String
  service      Service         @relation(fields: [serviceId], references: [id])
  sessions     Int
  price        Decimal         @db.Decimal(10, 2)
  /// Pacote: validade em dias (vazio = sem validade). Assinatura: o ciclo é mensal.
  validityDays Int?
  recurring    Boolean         @default(false)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sold         ClientPackage[]

  @@index([companyId, active])
}

enum ClientPackageStatus {
  ACTIVE
  CANCELED
}

/// Pacote/assinatura vendido a um cliente: sessões usadas na comanda.
model ClientPackage {
  id                        String              @id @default(cuid())
  companyId                 String
  company                   Company             @relation(fields: [companyId], references: [id])
  clientId                  String
  client                    Client              @relation(fields: [clientId], references: [id])
  /// Vazio quando o pacote foi cadastrado direto no cliente (sem plano à venda).
  planId                    String?
  plan                      PackagePlan?        @relation(fields: [planId], references: [id])
  nameSnapshot              String
  serviceId                 String
  service                   Service             @relation(fields: [serviceId], references: [id])
  sessionsTotal             Int
  sessionsUsed              Int                 @default(0)
  /// Valor de cada sessão (preço ÷ sessões): base da comissão quando a sessão é usada.
  sessionValue              Decimal             @db.Decimal(10, 2)
  price                     Decimal             @db.Decimal(10, 2)
  recurring                 Boolean             @default(false)
  /// Ciclo atual da assinatura; no pacote, periodEnd é a validade (vazio = sem validade).
  periodStart               DateTime            @default(now())
  periodEnd                 DateTime?
  status                    ClientPackageStatus @default(ACTIVE)
  createdByUserId           String
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  credits                   AppointmentCredit[]
  /// Contratação: data informada (pacotes de antes do sistema) ou a da venda.
  contractedAt              DateTime?
  responsibleProfessionalId String?
  responsibleProfessional   Professional?       @relation(fields: [responsibleProfessionalId], references: [id])
  notes                     String?
  /// Ficha inicial e formulário de acompanhamento por sessão (modelos de "Fichas e formulários").
  initialFormTemplateId     String?
  sessionFormTemplateId     String?
  /// Exige assinatura do cliente no registro de cada sessão.
  requireSignature          Boolean             @default(false)
  /// Saldo inicial de pacote contratado antes do sistema: valor já pago informado (sem lançamento).
  openingPaidAmount         Decimal?            @db.Decimal(10, 2)
  movements                 PackageMovement[]
  transactions              Transaction[]
  plannedAppointments       Appointment[]       @relation("PlannedPackageSessions")
  sessionRecords            SessionRecord[]
  formEntries               FormEntry[]

  @@index([companyId, clientId, status])
}

enum GiftCardStatus {
  ACTIVE
  CANCELED
}

/// Vale-presente: vendido por um valor, usado como pagamento na comanda até acabar o saldo.
model GiftCard {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  code            String
  initialAmount   Decimal             @db.Decimal(10, 2)
  balance         Decimal             @db.Decimal(10, 2)
  buyerName       String?
  recipientName   String?
  clientId        String?
  client          Client?             @relation(fields: [clientId], references: [id])
  expiresAt       DateTime?
  status          GiftCardStatus      @default(ACTIVE)
  createdByUserId String
  createdAt       DateTime            @default(now())
  credits         AppointmentCredit[]

  @@unique([companyId, code])
}

enum AppointmentCreditKind {
  PACKAGE
  GIFT_CARD
}

/// Parte do atendimento paga com crédito vendido antes (sessão de pacote, saldo de vale).
/// Não é dinheiro novo no caixa, mas entra na base da comissão.
model AppointmentCredit {
  id              String                @id @default(cuid())
  appointmentId   String
  appointment     Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  kind            AppointmentCreditKind
  clientPackageId String?
  clientPackage   ClientPackage?        @relation(fields: [clientPackageId], references: [id])
  giftCardId      String?
  giftCard        GiftCard?             @relation(fields: [giftCardId], references: [id])
  amount          Decimal               @db.Decimal(10, 2)
  createdAt       DateTime              @default(now())

  @@index([appointmentId])
}

/// Avaliação do cliente depois do atendimento (link enviado pelo WhatsApp).
model Review {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  appointmentId  String       @unique
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  rating         Int
  comment        String?
  createdAt      DateTime     @default(now())

  @@index([companyId, createdAt])
  @@index([professionalId])
}

/// Mensagem para um segmento de clientes (sumidos, aniversariantes, VIP...), enviada pelo WhatsApp.
model Campaign {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  name            String
  segment         String
  message         String
  couponCode      String?
  createdByUserId String
  createdAt       DateTime            @default(now())
  recipients      CampaignRecipient[]

  @@index([companyId, createdAt])
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  sentAt     DateTime?

  @@unique([campaignId, clientId])
}

// ---- Fichas e formulários ----------------------------------------------------------------------

enum FormType {
  ANAMNESIS
  ASSESSMENT
  SERVICE_RECORD
  CUSTOM
}

enum FormTemplateStatus {
  ACTIVE
  ARCHIVED
}

/// Quem pode preencher: só a equipe, só o cliente (pelo link) ou ambos.
enum FormFiller {
  PROFESSIONAL
  CLIENT
  BOTH
}

/// Quando pedir de novo: a cada atendimento, uma única vez ou depois de N dias.
enum FormRenewal {
  EACH_VISIT
  ONCE
  AFTER_DAYS
}

/// Exigência para iniciar o atendimento: nenhuma, ficha enviada ou ficha revisada.
enum FormRequirement {
  NONE
  SUBMITTED
  REVIEWED
}

/// REQUESTED = pedida e ainda sem resposta ("Não preenchida").
enum FormEntryStatus {
  REQUESTED
  DRAFT
  SUBMITTED
  REVIEWED
}

enum FormFilledBy {
  CLIENT
  STAFF
}

/// Modelo de ficha. O conteúdo vive nas versões: editar cria uma versão nova e as fichas já
/// preenchidas continuam presas à versão que usaram.
model FormTemplate {
  id              String                @id @default(cuid())
  companyId       String
  company         Company               @relation(fields: [companyId], references: [id])
  name            String
  type            FormType
  status          FormTemplateStatus    @default(ACTIVE)
  currentVersion  Int                   @default(1)
  createdByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  versions        FormTemplateVersion[]
  services        FormTemplateService[]
  entries         FormEntry[]

  @@index([companyId, status])
}

/// Versão imutável do modelo: perguntas (schema), regras de preenchimento e exigência.
model FormTemplateVersion {
  id              String          @id @default(cuid())
  templateId      String
  template        FormTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  companyId       String
  version         Int
  name            String
  description     String?
  instructions    String?
  fillableBy      FormFiller      @default(BOTH)
  renewal         FormRenewal     @default(ONCE)
  renewalDays     Int?
  requirement     FormRequirement @default(NONE)
  /// { sections: [{ id, title, questions: [{ id, type, title, help, required, options, showIf }] }] }
  schema          Json
  createdByUserId String
  createdAt       DateTime        @default(now())
  entries         FormEntry[]

  @@unique([templateId, version])
}

model FormTemplateService {
  templateId String
  template   FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service      @relation(fields: [serviceId], references: [id])
  companyId  String

  @@id([templateId, serviceId])
  @@index([companyId, serviceId])
}

/// Um preenchimento (ou pedido de preenchimento) de um cliente. Respostas enviadas nunca são
/// sobrescritas em silêncio: cada envio fica em FormEntryRevision.
model FormEntry {
  id                 String              @id @default(cuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id])
  clientId           String
  client             Client              @relation(fields: [clientId], references: [id])
  templateId         String
  template           FormTemplate        @relation(fields: [templateId], references: [id])
  versionId          String
  version            FormTemplateVersion @relation(fields: [versionId], references: [id])
  status             FormEntryStatus     @default(REQUESTED)
  appointmentId      String?
  appointment        Appointment?        @relation(fields: [appointmentId], references: [id])
  clientPackageId    String?
  clientPackage      ClientPackage?      @relation(fields: [clientPackageId], references: [id])
  sessionRecordId    String?
  sessionRecord      SessionRecord?      @relation(fields: [sessionRecordId], references: [id])
  /// Respostas atuais (rascunho ou enviadas), por id estável de pergunta.
  answers            Json?
  /// Atualização iniciada com as respostas de uma ficha anterior: precisa ser conferida.
  copiedFromEntryId  String?
  filledBy           FormFilledBy?
  filledByUserId     String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedByUserId   String?
  /// Observação interna da revisão: nunca aparece para o cliente.
  reviewNotes        String?
  revision           Int                 @default(0)
  /// Liberada para o cliente ver na área do cliente (só o que a equipe liberar).
  releasedToClientAt DateTime?
  /// Evita pedidos repetidos (recarregar a página, vários serviços pedindo o mesmo modelo).
  requestKey         String?             @unique
  createdByUserId    String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  revisions          FormEntryRevision[]
  accessTokens       FormAccessToken[]

  @@index([companyId, clientId])
  @@index([companyId, status])
  @@index([appointmentId])
}

/// Conteúdo de cada envio: corrigir uma ficha enviada cria uma revisão nova, preservando a anterior.
model FormEntryRevision {
  id             String       @id @default(cuid())
  entryId        String
  entry          FormEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  companyId      String
  revision       Int
  answers        Json
  filledBy       FormFilledBy
  filledByUserId String?
  reason         String?
  submittedAt    DateTime     @default(now())

  @@unique([entryId, revision])
}

/// Link público de preenchimento: só o hash do token fica no banco; vale para uma ficha só.
model FormAccessToken {
  id              String    @id @default(cuid())
  companyId       String
  entryId         String
  entry           FormEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  usedAt          DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())

  @@index([entryId])
}

enum FormAccessScope {
  ALL
  OWN
}

/// O que cada pessoa da equipe pode fazer com as fichas. Ver o status é de todos; ler respostas,
/// preencher, revisar e exportar só com permissão explícita — inclusive para administradores.
model FormPermission {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id])
  userId          String
  /// Pedir ficha e gerar link para o cliente (não dá acesso às respostas).
  canRequest      Boolean         @default(true)
  canRead         Boolean         @default(false)
  canFill         Boolean         @default(false)
  canReview       Boolean         @default(false)
  canExport       Boolean         @default(false)
  canManage       Boolean         @default(false)
  /// Ver quem acessou e alterou fichas (o registro nunca guarda o conteúdo das respostas).
  canAudit        Boolean         @default(false)
  /// OWN: só fichas de atendimentos do próprio profissional (ligado pelo e-mail).
  scope           FormAccessScope @default(ALL)
  updatedByUserId String
  updatedAt       DateTime        @updatedAt

  @@unique([companyId, userId])
}

// ---- Pacotes: movimentos e registro por sessão -------------------------------------------------

/// Livro do pacote: o progresso sai daqui, não de um campo editável. CONSUME/RESTORE vêm da
/// conclusão/estorno do atendimento; OPENING_DONE é o saldo inicial de pacote anterior ao sistema;
/// EXTEND amplia o pacote; ADJUST é correção manual auditada.
enum PackageMovementKind {
  CONSUME
  RESTORE
  OPENING_DONE
  EXTEND
  ADJUST
}

model PackageMovement {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  clientPackageId String
  clientPackage   ClientPackage       @relation(fields: [clientPackageId], references: [id])
  kind            PackageMovementKind
  /// Sessões realizadas (CONSUME +1, RESTORE −1, OPENING_DONE +n, ADJUST ±n) ou ampliadas (EXTEND +n).
  quantity        Int
  appointmentId   String?
  appointment     Appointment?        @relation(fields: [appointmentId], references: [id])
  /// Número da sessão realizada (CONSUME).
  sessionNumber   Int?
  reason          String?
  createdByUserId String
  createdAt       DateTime            @default(now())

  @@index([clientPackageId])
}

enum SessionRecordStatus {
  DRAFT
  FINALIZED
  AMENDED
}

/// Registro de um atendimento (sessão de pacote ou avulso): versões imutáveis e assinaturas.
model SessionRecord {
  id               String                 @id @default(cuid())
  companyId        String
  company          Company                @relation(fields: [companyId], references: [id])
  clientId         String
  client           Client                 @relation(fields: [clientId], references: [id])
  appointmentId    String                 @unique
  appointment      Appointment            @relation(fields: [appointmentId], references: [id])
  clientPackageId  String?
  clientPackage    ClientPackage?         @relation(fields: [clientPackageId], references: [id])
  professionalId   String
  professional     Professional           @relation(fields: [professionalId], references: [id])
  status           SessionRecordStatus    @default(DRAFT)
  currentVersion   Int                    @default(0)
  requireSignature Boolean                @default(false)
  createdByUserId  String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  versions         SessionRecordVersion[]
  signatures       SessionSignature[]
  formEntries      FormEntry[]

  @@index([companyId, clientId])
}

/// Conteúdo de uma versão do registro. O que o cliente confirma (contentHash) não inclui as
/// observações internas.
model SessionRecordVersion {
  id              String            @id @default(cuid())
  recordId        String
  record          SessionRecord     @relation(fields: [recordId], references: [id], onDelete: Cascade)
  companyId       String
  version         Int
  procedure       String
  clientReport    String?
  orientations    String?
  nextReturn      String?
  internalNotes   String?
  amendmentReason String?
  contentHash     String
  createdByUserId String
  createdAt       DateTime          @default(now())
  signature       SessionSignature?

  @@unique([recordId, version])
}

/// Assinatura desenhada pelo cliente, presa à versão exata do registro que ele viu.
model SessionSignature {
  id                String               @id @default(cuid())
  companyId         String
  recordId          String
  record            SessionRecord        @relation(fields: [recordId], references: [id], onDelete: Cascade)
  versionId         String               @unique
  version           SessionRecordVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  signerName        String
  /// PNG (data URL) do traço.
  image             String
  method            String
  statement         String
  contentHash       String
  collectedByUserId String
  signedAt          DateTime             @default(now())
}

/// Entrada de mercadoria (compra do fornecedor): soma no estoque, atualiza o custo médio e lança a
/// conta (paga ou a pagar).
model StockPurchase {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  supplier        String?
  invoiceNumber   String?
  total           Decimal             @db.Decimal(10, 2)
  transactionId   String?
  createdByUserId String
  createdAt       DateTime            @default(now())
  items           StockPurchaseItem[]

  @@index([companyId, createdAt])
}

model StockPurchaseItem {
  id         String        @id @default(cuid())
  purchaseId String
  purchase   StockPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal       @db.Decimal(10, 2)
}

enum DepositStatus {
  PENDING
  PAID
  EXPIRED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum WhatsappMessageStatus {
  PENDING
  SENT
  FAILED
}

/// Mensagem automática enviada pela Z-API. dedupeKey impede mandar a mesma duas vezes
/// (ex.: "reminder:<agendamento>", "birthday:<cliente>:2026").
model WhatsappMessage {
  id            String                @id @default(cuid())
  companyId     String
  company       Company               @relation(fields: [companyId], references: [id])
  kind          String
  dedupeKey     String
  phone         String
  text          String
  status        WhatsappMessageStatus @default(PENDING)
  error         String?
  providerId    String?
  clientId      String?
  appointmentId String?
  createdAt     DateTime              @default(now())

  @@unique([companyId, dedupeKey])
  @@index([companyId, createdAt])
}

// ---- IA: franquia, consumo, propostas e autonomia ----------------------------------------------

enum AiAutonomyMode {
  SUGGEST
  APPROVAL
  AUTO_RULES
}

/// Consumo de IA do mês (unidades efetivamente gastas). A reserva fica em AiUsageReservation.
model AiUsagePeriod {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  /// "AAAA-MM" no fuso da empresa.
  period       String
  usedUnits    Int      @default(0)
  audioSeconds Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([companyId, period])
}

enum AiReservationStatus {
  ACTIVE
  SETTLED
  RELEASED
}

/// Reserva feita ANTES de chamar o provedor: pedidos simultâneos não passam do saldo. Expira
/// sozinha se o processo cair no meio (não fica presa).
model AiUsageReservation {
  id        String              @id @default(cuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id])
  period    String
  units     Int
  feature   String
  status    AiReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime            @default(now())

  @@index([companyId, period, status])
}

enum AiUsageOutcome {
  SUCCEEDED
  FAILED
  BLOCKED
}

/// Medição de custo por chamada. Sem o conteúdo das mensagens: só números e o tipo de operação.
model AiUsageEvent {
  id                  String         @id @default(cuid())
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id])
  userId              String?
  /// assistant_chat | voice_command | form_template | automation | whatsapp_ai
  feature             String
  provider            String
  model               String?
  inputTokens         Int            @default(0)
  outputTokens        Int            @default(0)
  /// Outros consumos cobrados pelo provedor, quando informados (ex.: tokens de raciocínio).
  otherUsage          Json?
  audioSeconds        Int?
  calls               Int            @default(0)
  units               Int            @default(0)
  /// Custo estimado em milionésimos da moeda (ex.: 1500 = US$ 0,0015).
  estimatedCostMicros Int            @default(0)
  currency            String         @default("USD")
  outcome             AiUsageOutcome
  errorCode           String?
  createdAt           DateTime       @default(now())

  @@index([companyId, createdAt])
}

enum AiProposalStatus {
  PROPOSED
  AWAITING_APPROVAL
  EXECUTING
  COMPLETED
  FAILED
  CANCELED
  EXPIRED
  /// Recusada por quem aprova (na Central de aprovações).
  REJECTED
}

/// Alteração preparada pela IA. Só executa a partir daqui (nunca do que o navegador mandar), uma
/// vez só; se o resumo mudar entre propor e confirmar, volta a pedir aprovação.
model AiActionProposal {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  userId          String
  kind            String
  /// Argumentos validados. Conteúdo sensível (respostas de ficha) é apagado ao encerrar.
  payload         Json
  /// Resumo mostrado na prévia (título e linhas) e o hash dele.
  summary         Json
  summaryHash     String
  status          AiProposalStatus @default(AWAITING_APPROVAL)
  /// assistant | automation
  origin          String           @default("assistant")
  authorizationId String?
  resultMessage   String?
  errorMessage    String?
  /// Quem aprovou, recusou ou cancelou (pode ser um administrador, não quem pediu).
  decidedByUserId String?
  decisionNote    String?
  expiresAt       DateTime
  decidedAt       DateTime?
  executedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([companyId, userId, status])
}

enum AiAuthorizationStatus {
  ACTIVE
  PAUSED
  REVOKED
}

/// Autorização de UMA tarefa ou rotina para execução automática (só no Pro). Nunca genérica.
/// Criada e alterada só por uma pessoa administradora — a automação não mexe na própria permissão.
model AiTaskAuthorization {
  id              String                @id @default(cuid())
  companyId       String
  company         Company               @relation(fields: [companyId], references: [id])
  taskType        String
  status          AiAuthorizationStatus @default(ACTIVE)
  /// Escopo (público, serviços, unidades…) e limites (frequência, horários, gasto).
  scope           Json?
  limits          Json?
  pausedReason    String?
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([companyId, status])
}

enum AddOnStatus {
  INACTIVE
  ACTIVE
  PAUSED
}

enum AddOnIntegrationStatus {
  NOT_CONFIGURED
  CONNECTED
  ERROR
}

/// Adicional contratado (ex.: atendimento com IA no WhatsApp), separado do plano.
model CompanyAddOn {
  id                String                 @id @default(cuid())
  companyId         String
  company           Company                @relation(fields: [companyId], references: [id])
  addOnId           String
  status            AddOnStatus            @default(INACTIVE)
  integrationStatus AddOnIntegrationStatus @default(NOT_CONFIGURED)
  /// Franquia própria do adicional e teto de gastos (centavos); null = não definido (bloqueia).
  monthlyQuota      Int?
  spendLimitCents   Int?
  /// Regras de autorização de envios (horários, público, frequência).
  sendRules         Json?
  activatedAt       DateTime?
  updatedByUserId   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([companyId, addOnId])
}

/// Material que um serviço consome do estoque a cada atendimento concluído.
model ServiceSupply {
  id        String  @id @default(cuid())
  companyId String
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@unique([serviceId, productId])
  @@index([companyId, serviceId])
  @@index([productId])
}

/// Preferências do negócio. Três coisas que não se misturam:
/// - linguagem (tom, observações): só orientam o texto da IA, nunca liberam nada;
/// - regras aplicadas no servidor (limite de desconto, horário de contato, gasto automático);
/// - permissões de acesso continuam nos papéis da organização e nas permissões de fichas.
model BusinessPreferences {
  companyId           String    @id
  company             Company   @relation(fields: [companyId], references: [id])
  /// cordial | formal | descontraido
  tone                String    @default("cordial")
  /// Observações de linguagem para a IA (texto livre, tratado como dado).
  languageNotes       String?
  /// Quando chamar uma pessoa da equipe em vez de seguir (texto para a IA e lista de casos).
  escalationNotes     String?
  escalateOnComplaint Boolean   @default(true)
  escalateOnHealth    Boolean   @default(true)
  /// Janela de contato com clientes (minutos desde a meia-noite, fuso da empresa) e dias (0 = dom).
  contactStartMinutes Int       @default(480)
  contactEndMinutes   Int       @default(1200)
  contactWeekdays     Int[]     @default([1, 2, 3, 4, 5, 6])
  /// Desconto máximo em orçamentos (%). Vazio = sem limite.
  maxDiscountPercent  Int?
  /// Ações da IA com valor acima disto sempre pedem aprovação, mesmo em rotina autorizada (centavos).
  approvalAboveCents  Int?
  /// Teto mensal de unidades de IA para rotinas automáticas (dentro da franquia). Vazio = sem rotinas com IA.
  autoSpendLimitUnits Int?
  /// Resumo do dia: gerar sozinho (Pro) e a hora local.
  dailySummaryAuto    Boolean   @default(false)
  dailySummaryHour    Int       @default(7)
  /// Avisos no sino.
  notifyQuotes        Boolean   @default(true)
  notifyTasks         Boolean   @default(true)
  notifyApprovals     Boolean   @default(true)
  /// Pausa das ações automáticas: geral e por rotina. O uso manual continua normal.
  automationsPaused   Boolean   @default(false)
  pausedRoutines      String[]  @default([])
  pausedAt            DateTime?
  pausedByUserId      String?
  updatedByUserId     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// Importação assistida (clientes ou produtos). O arquivo não é guardado: só o hash (para repetir
/// sem duplicar) e o relatório por linha, sem os valores das linhas.
model ImportBatch {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  /// clients | products
  kind            String
  fileHash        String
  /// Mapeamento de colunas e modo de duplicados usados (hash).
  optionsHash     String
  fileName        String?
  /// RUNNING | DONE | PARTIAL | FAILED
  status          String
  totalRows       Int
  created         Int       @default(0)
  updated         Int       @default(0)
  skipped         Int       @default(0)
  failed          Int       @default(0)
  /// [{ row, outcome, message }]
  report          Json?
  createdByUserId String
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@unique([companyId, kind, fileHash, optionsHash])
  @@index([companyId, createdAt])
}

/// Uma execução de rotina automática (renovação de pacotes, lista de espera, resumo do dia).
model AutomationRun {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  /// package_renewal | waitlist_auto | daily_summary
  routine    String
  /// cron | manual
  trigger    String
  /// RUNNING | COMPLETED | PARTIAL | FAILED | SKIPPED
  status     String
  /// Contagens verificáveis do que a rotina fez (tarefas, orçamentos, convites, pulados, falhas).
  stats      Json?
  /// Motivo de ter sido pulada (pausada, fora do plano, sem saldo) ou do erro.
  note       String?
  aiUnits    Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([companyId, routine, startedAt])
}

/// Resumo do dia (cálculo determinístico; a IA só explica, quando pedida).
model DailySummary {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  /// AAAA-MM-DD no fuso da empresa.
  date        String   @db.VarChar(10)
  content     Json
  /// manual | cron
  trigger     String
  generatedAt DateTime @default(now())

  @@unique([companyId, date])
}
