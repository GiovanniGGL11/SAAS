generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id         String    @id @default(cuid())
  clerkOrgId String    @unique
  name       String
  slug       String    @unique
  timezone   String    @default("America/Sao_Paulo")
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  professionals  Professional[]
  services       Service[]
  clients        Client[]
  appointments   Appointment[]
  auditLogs      AuditLog[]
  products       Product[]
  stockMovements StockMovement[]
  transactions   Transaction[]
  coupons        Coupon[]
}

model WebhookEvent {
  id           String   @id @default(cuid())
  clerkEventId String   @unique
  type         String
  processedAt  DateTime @default(now())
}

enum CommissionType {
  FIXED
  PERCENTAGE
}

model Professional {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id])
  name            String
  email           String?
  phone           String?
  color           String
  avatarUrl       String?
  active          Boolean         @default(true)
  commissionType  CommissionType?
  commissionValue Decimal?        @db.Decimal(10, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  availabilities ProfessionalAvailability[]
  blocks         ScheduleBlock[]
  appointments   Appointment[]

  @@unique([companyId, email])
  @@index([companyId])
}

model ProfessionalAvailability {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Int
  startTime      String
  endTime        String

  @@index([professionalId, weekday])
}

model ScheduleBlock {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startAt        DateTime
  endAt          DateTime
  reason         String?

  @@index([professionalId, startAt, endAt])
}

model Service {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  name            String
  description     String?
  category        String?
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  color           String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments Appointment[]

  @@index([companyId])
}

model Client {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  name      String
  phone     String?
  email     String?
  cpf       String?
  birthDate DateTime?
  notes     String?
  isVip     Boolean   @default(false)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  appointments Appointment[]

  @@unique([companyId, phone])
  @@index([companyId])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELED
  NO_SHOW
}

model Appointment {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])

  startAt DateTime
  endAt   DateTime
  status  AppointmentStatus @default(SCHEDULED)

  // Snapshot at creation time so edits to Service later don't rewrite history.
  serviceNameSnapshot     String
  durationMinutesSnapshot Int
  priceSnapshot           Decimal @db.Decimal(10, 2)

  notes String?

  createdByUserId    String
  updatedByUserId    String?
  canceledAt         DateTime?
  canceledByUserId   String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productSales AppointmentProduct[]
  transactions Transaction[]

  @@index([companyId, startAt])
  @@index([companyId, professionalId, startAt])
  @@index([companyId, status, startAt])
  @@index([companyId, clientId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  entityType String
  entityId   String
  action     String
  userId     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([companyId, entityType, entityId])
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  sku         String?
  description String?
  costPrice   Decimal  @db.Decimal(10, 2)
  salePrice   Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(0)
  minQuantity Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements        StockMovement[]
  appointmentSales AppointmentProduct[]

  @@unique([companyId, sku])
  @@index([companyId])
}

enum StockMovementType {
  IN
  OUT
  SALE
}

model StockMovement {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  type            StockMovementType
  quantity        Int
  reason          String?
  createdByUserId String
  createdAt       DateTime          @default(now())

  @@index([companyId, productId])
  @@index([companyId, createdAt])
}

// Line item for a product sold during an appointment (e.g. a shampoo sold
// alongside a haircut). Debits stock via a StockMovement(type=SALE) and
// generates its own Transaction — kept separate from the appointment's
// service-completion Transaction since a checkout can have several items.
model AppointmentProduct {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int
  priceSnapshot Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELED
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  OTHER
}

model Transaction {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  type            TransactionType
  status          TransactionStatus @default(PAID)
  description     String
  category        String?
  amount          Decimal           @db.Decimal(10, 2)
  paymentMethod   PaymentMethod?
  dueDate         DateTime?
  paidAt          DateTime?
  appointmentId   String?
  appointment     Appointment?      @relation(fields: [appointmentId], references: [id])
  notes           String?
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([companyId, type, status])
  @@index([companyId, dueDate])
  @@index([companyId, paidAt])
  @@index([appointmentId])
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id])
  code          String
  description   String?
  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(10, 2)
  active        Boolean            @default(true)
  expiresAt     DateTime?
  maxUses       Int?
  usedCount     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}
